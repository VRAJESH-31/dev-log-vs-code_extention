{
  "name": "auto-devlog",
  "displayName": "auto-devlog",
  "description": "Automated Developer Log",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "auto-devlog.showStats",
        "title": "DevLog: Show Session Stats"
      },
      {
        "command": "auto-devlog.stopSession",
        "title": "DevLog: Stop Session & Generate Log"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.104.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
